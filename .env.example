# Copy this file to .env and fill in your real values
# .env is in .gitignore -- never gets pushed to GitHub

# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Lambda function to monitor
LAMBDA_FUNCTION_NAME=demo-healing-function

# AWS Profile (for local development)
AWS_PROFILE=devops-demo

# Git functions for auto-PR (optional, but required for auto-PR feature)
GITHUB_TOKEN=ghp_...        # repo + pull_requests scope
GITHUB_REPO=abiramikannanofficial-dotcom/self-healing-starter
GITHUB_BRANCH=develop